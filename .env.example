# Copy this file to .env and fill in local values. Do not commit .env.

# App
# APP_NAME=AIOps Assistant
# APP_VERSION=1.0.0
# DEBUG=false
# HOST=0.0.0.0
# PORT=9900

# LLM provider
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://dasuapi.com/v1
# LLM_API_KEY=your-llm-api-key-here
# LLM_MODEL=gpt-5.4
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=0
# LLM_RETRY_BASE_DELAY=0.5
# Optional model-tier overrides. Leave blank to reuse LLM_MODEL.
# LLM_PLANNER_MODEL=
# LLM_REASONER_MODEL=
# HARNESS_ROLLING_SUMMARY_MODEL=
# ROUTER_CONCRETE_INCIDENT_OVERRIDE_ENABLED=true  # concrete target + incident signal: knowledge -> diagnosis

# DashScope (optional: LLM legacy fallback, or EMBEDDING_PROVIDER=dashscope)
# DASHSCOPE_API_KEY=your-dashscope-api-key-here
# DASHSCOPE_MODEL=
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# Embeddings (default: local BGE-M3 — no API key; install: pip install -e ".[embedding]")
# EMBEDDING_PROVIDER=local_bge_m3   # local_bge_m3 | dashscope
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_MODEL_PATH=            # optional local path override
# EMBEDDING_DIM=1024
# EMBEDDING_DEVICE=                # empty=auto; cpu | cuda
# EMBEDDING_BATCH_SIZE=12
# EMBEDDING_NORMALIZE=true
# EMBEDDING_USE_FP16=true
# After switching embedding model/provider, rebuild vectors:
#   python scripts/rebuild_vector_collection.py --yes
#   then rebuild experience memory index via API/service

# RAG
# RAG_TOP_K=3
# RAG_RETRIEVAL_MODE=dense
# RAG_DENSE_WEIGHT=0.7
# RAG_BM25_WEIGHT=0.3
# RAG_TENANT_SCOPE_ENABLED=true
# RAG_ALLOW_LEGACY_UNSCOPED=false
# RAG_COLLECTION_NAME=biz_v2       # rollback/observation only: biz
# DB_SCHEMA_ENFORCEMENT_ENABLED=false
# STATIC_SERVE_ENABLED=false
# Runtime observability (production defaults are fail-closed)
# METRICS_ACCESS_MODE=internal       # internal | bearer | public(debug only)
# METRICS_BEARER_TOKEN=              # required when mode=bearer
# METRICS_PUBLIC_DEBUG_ENABLED=false
# HEALTH_DETAILS_ENABLED=false

# Agent harness
# HTTP /api/assistant always uses harness_service; HARNESS_ENABLED mainly gates checkpoint etc.
# HARNESS_ENABLED=true
# HARNESS_MAX_STEPS=6
# HARNESS_TOKEN_BUDGET=16000
# HARNESS_TIMEOUT_SECONDS=240
# HARNESS_MCP_ENABLED=false
# HARNESS_DELEGATION_ENABLED=true
# HARNESS_FORCE_EXPERT_DELEGATION=false   # true: seed first delegate_to_expert before model loop
# HARNESS_DELEGATE_TIMEOUT_SECONDS=90
# HARNESS_TOOL_TIMEOUT_SECONDS=30
# HARNESS_STEP_TIMEOUT_SECONDS=60
# HARNESS_CORRECTIVE_VERIFY_ENABLED=true
# HARNESS_RE_EVIDENCE_ENABLED=true        # M1: low-confidence → one more tool pass
# HARNESS_RE_EVIDENCE_MAX_ROUNDS=1
# HARNESS_EVIDENCE_MATCH_ENABLED=true     # M1 W2: match required_evidence classes to tools
# HARNESS_REPLAN_ENABLED=true             # M1 W3: mid-loop / post re-evidence rule replan
# HARNESS_REPLAN_MAX_TIMES=1
# HARNESS_DYNAMIC_MAX_STEPS=true          # knowledge/clarify → max_steps min(3, max)
# HARNESS_PARALLEL_TOOL_CALLS=true        # same-step multi tool_call gather
# HARNESS_KNOWLEDGE_EARLY_CLOSE=true      # M1 W4: knowledge + successful retrieve → close
# HARNESS_ROUTE_TIMEOUT_PROFILE=true      # M1 W4: knowledge soft timeout / tighter steps
# HARNESS_DIAGNOSIS_MAX_STEPS=3           # M2 W5: profile-on diagnosis cap; set 5 to match pilot legacy budget
# HARNESS_INVESTIGATION_EVIDENCE_EARLY_CLOSE=true # M2 W5: evidence-first route close; false restores prior loop
# HARNESS_DELEGATE_MAX_TOOL_ROUNDS=1      # M2 W5: serial delegate cap; set 2/3 to restore a wider budget
# HARNESS_DELEGATE_EVIDENCE_ONLY=true      # M2 W5: parent synthesizes delegated evidence; false restores expert summary
# HARNESS_PARALLEL_DELEGATION_ENABLED=true # M2 W6: register delegate_parallel; false restores serial-only
# HARNESS_PARALLEL_MAX_EXPERTS=3           # M2 W6: fan-out cap; set 1 to effectively disable parallel
# ROUTER_AUX_EXECUTION_MODE=parallel       # M2 W6: off|serial|parallel (invalid → off)
# ROUTER_AUX_MAX_PROBES=2                  # M2 W6: max aux experts auto-probed; 0 ≈ off
# HARNESS_TRACE_EXPORT_ENABLED=false       # M2 W6: write volumes/traces/{session}.json on complete
# HARNESS_TRACE_EXPORT_DIR=volumes/traces
# HARNESS_TRACE_SAMPLE_RATE=0.0            # M3 W11: 0–1; only when export enabled; 0 = never write
# OTEL_EXPORTER_OTLP_ENDPOINT=             # M3 W11: empty = off (no OTEL dep required)
# HARNESS_SHARED_KERNEL_DELEGATION=true    # M2 W7: experts use sub_harness kernel (single loop body)
# CHANGE_SOURCE_POLICY=unavailable         # M2 W7: unavailable|future — no live change source (option B)
# M3 W9 residuals / HITL / metrics
# HARNESS_FORCE_PARALLEL_ON_CROSS_DOMAIN=true  # seed delegate_parallel for cross-domain
# HARNESS_REPLAN_ON_PRIMARY_FAIL=true          # replan even if weak evidence exists
# HARNESS_SLOW_PATH_TOOL_CAP=2                 # cap repeated successful tool names; 0 disables
# HARNESS_TIMEOUT_SOFT_CLOSE_ENABLED=true      # evidence-based close on outer timeout
# HITL_SUGGESTED_ACTIONS_ENABLED=true
# ONCALL_ESCALATION_CONTACTS=                 # name|channel;name2|channel2
# M3 W10 learn / anti-pattern / distill
# LONG_TERM_MEMORY_DISTILL_ENABLED=true       # complete 可生成 draft
# LONG_TERM_MEMORY_AUTO_DISTILL=false         # false: pending only; true+no-confirm: direct active
# LONG_TERM_MEMORY_DISTILL_REQUIRE_CONFIRM=true
# LONG_TERM_MEMORY_AUTO_DISTILL_MIN_CONFIDENCE=medium
# HARNESS_ANTI_PATTERN_CAPTURE_ENABLED=true
# EXPERT_TIMEOUT_SECONDS=120

# Stateful Harness context whiteboard (enabled by default in code)
# PRIMARY path: true = ContextState whiteboard. false = legacy ContextBuilder
# (rebuild/fallback only; see docs/pilot/context-dual-path.md). New features
# land on stateful only — legacy is deprecated, not deleted.
# HARNESS_STATEFUL_CONTEXT_ENABLED=true
# HARNESS_CONTEXT_REBUILD_FROM_TURNS_ENABLED=true
# HARNESS_CONTEXT_VIEW_TOKEN_BUDGET=4000
# HARNESS_CONTEXT_REDIS_TTL_SECONDS=86400
# HARNESS_CONTEXT_DB_SNAPSHOT_ENABLED=true
# HARNESS_CONTEXT_PATCH_HISTORY_LIMIT=200
# HARNESS_CONTEXT_TOOLS_ENABLED=true

# Logs and runtime limits
# LOG_MAX_LINES=20000
# LOG_TOKEN_BUDGET=12000
# LOG_CHUNK_SIZE=8000
# LOG_TOP_PATTERNS=30
# LOG_SUMMARY_MODEL=

# Milvus
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# MILVUS_TIMEOUT=10000

# MCP servers
# MCP_CLS_TRANSPORT=streamable-http
# MCP_CLS_URL=http://localhost:8003/mcp
# MCP_MONITOR_TRANSPORT=streamable-http
# MCP_MONITOR_URL=http://localhost:8004/mcp

# Prometheus / monitor
# PROMETHEUS_BASE_URL=http://127.0.0.1:9090
# PROMETHEUS_REQUEST_TIMEOUT=10
# MONITOR_TARGET_MODE=prometheus  # L1 pilot; self=local psutil demo only
# LOG_PROVIDER=local

# Storage
# CHECKPOINT_DB_PATH=volumes/checkpoints.db
# MEMORY_DB_PATH=volumes/long_term_memory.db
# PROJECT_ID=super_biz_agent

# Redis (used by the harness loop checkpoint subsystem)
# REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379/0
# REDIS_NAMESPACE=super_biz_agent
# REDIS_SOCKET_TIMEOUT=5.0
# REDIS_PROTOCOL=2

# Harness loop checkpoint (only effective when HARNESS_ENABLED / HARNESS_CHECKPOINT_ENABLED / REDIS_ENABLED are all true)
# HARNESS_CHECKPOINT_ENABLED=false
# HARNESS_CHECKPOINT_TTL_SECONDS=1800
# HARNESS_CHECKPOINT_REPLAY=false                   # false=conservative (default), true=aggressive replay
# HARNESS_CHECKPOINT_REQUEST_OVERRIDE_ENABLED=false # normal requests cannot force aggressive replay
# HARNESS_EVAL_HOOKS_ENABLED=false                  # simulate/prefer_parallel are eval-only

# Auth
# AUTH_TOKEN_SECRET=replace-with-a-local-random-secret
# AUTH_TOKEN_TTL_SECONDS=86400
# AUTH_USERS=admin:admin
# AUTH_USER_ROLES=admin:admin,pilot:operator        # operator | curator | admin
# AUTH_USER_PROJECTS=admin:super_biz_agent
# AUTH_ROLE_ENFORCEMENT_ENABLED=false               # phase 2 after role mappings are deployed
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# NOTE: rotating AUTH_TOKEN_SECRET invalidates every previously issued token
# and forces all clients to re-login. Keep the secret stable across restarts
# unless you intentionally want a global logout.

# File storage backend
# STORAGE_BACKEND=local                       # local | minio | oss | s3 | cos
# STORAGE_LOCAL_ROOT=volumes/file_storage
# STORAGE_CACHE_DIR=volumes/file_storage/_cache
# STORAGE_MAX_FILE_SIZE_MB=50
# STORAGE_ALLOWED_EXTENSIONS=.txt,.text,.md,.markdown,.pdf,.docx

# Object storage (S3-compatible, used when STORAGE_BACKEND != local)
# STORAGE_ENDPOINT=http://127.0.0.1:9000
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin
# STORAGE_BUCKET=super-biz-agent
# STORAGE_USE_SSL=false
# STORAGE_URL_STYLE=path                       # path | virtual-hosted
# STORAGE_PUBLIC_URL_BASE=

# Change source is currently a skeleton (CHANGE_SOURCE_AVAILABLE=false)
# query_recent_changes returns source_available=false; do not invent change records.

# Auth (pilot)
# AUTH_TOKEN_SECRET=replace-with-strong-random
# AUTH_TOKEN_TTL_SECONDS=86400
# AUTH_USERS=admin:change-me,pilot:change-me
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pilot data plane
# LOG_PROVIDER=local
# PROMETHEUS_BASE_URL=http://127.0.0.1:9090
# MONITOR_TARGET_MODE=prometheus
